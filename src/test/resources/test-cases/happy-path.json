{
  "testCases": [
    {
      "name": "happy-path",
      "description": "Invoice with good credit score is approved and archived",
      "instructions": [
        {
          "type": "MOCK_JOB_WORKER_COMPLETE_JOB",
          "jobType": "archive-invoice",
          "variables": {
            "archivedAt": "2026-01-15"
          }
        },
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "invoice-approval"
          },
          "variables": {
            "invoiceId": "INV-1001",
            "amount": 4200,
            "creditScore": 720
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "invoice-approval"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "invoice-approval"
          },
          "elementSelectors": [
            { "elementId": "EndEvent_Approved" }
          ],
          "state": "IS_COMPLETED_IN_ORDER"
        }
      ]
    }
  ]
}
