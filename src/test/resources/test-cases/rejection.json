{
  "testCases": [
    {
      "name": "rejection",
      "description": "Invoice with poor credit score is rejected before archiving",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "invoice-approval"
          },
          "variables": {
            "invoiceId": "INV-1002",
            "amount": 15000,
            "creditScore": 480
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "invoice-approval"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "invoice-approval"
          },
          "elementSelectors": [
            { "elementId": "EndEvent_Rejected" }
          ],
          "state": "IS_COMPLETED_IN_ORDER"
        }
      ]
    }
  ]
}
